@model HotelBooking.Application.DTOs.ChangePasswordDto

@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-lg" style="border-radius: 16px; overflow: hidden;">
                <div class="p-4 text-center text-white" style="background-color: var(--primary-dark);">
                    <h3 class="mb-1 text-white" style="font-family: 'Playfair Display'; font-weight: 700;">Đổi Mật Khẩu</h3>
                    <p class="mb-0 text-white-50 small">Cập nhật mật khẩu mới cho tài khoản của bạn</p>
                </div>
                <div class="card-body p-4">
                    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                    <form asp-action="ChangePassword" method="post" class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-bold small text-muted"><i class="fa-solid fa-lock me-1 text-primary"></i> Mật khẩu cũ</label>
                            <input asp-for="OldPassword" class="form-control" type="password" placeholder="••••••••" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small text-muted"><i class="fa-solid fa-key me-1 text-primary"></i> Mật khẩu mới</label>
                            <input asp-for="NewPassword" class="form-control" type="password" placeholder="••••••••" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small text-muted"><i class="fa-solid fa-circle-check me-1 text-primary"></i> Xác nhận mật khẩu mới</label>
                            <input asp-for="ConfirmNewPassword" class="form-control" type="password" placeholder="••••••••" required />
                        </div>

                        <div class="col-12 mt-4 border-top pt-4 d-flex justify-content-between align-items-center">
                            <a asp-action="Profile" class="btn btn-outline-secondary" style="border-radius: 6px;">Quay lại</a>
                            <button type="submit" class="btn btn-primary px-4 py-2" style="border-radius: 6px;"><i class="fa-solid fa-circle-check me-1"></i> Xác Nhận</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
