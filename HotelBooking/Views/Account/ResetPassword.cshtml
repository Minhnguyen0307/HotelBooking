@model HotelBooking.Application.DTOs.ResetPasswordDto

@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-lg" style="border-radius: 16px; overflow: hidden;">
                <div class="p-4 text-center text-white" style="background-color: var(--primary-dark);">
                    <h3 class="mb-1 text-white" style="font-family: 'Playfair Display'; font-weight: 700;">Đặt Lại Mật Khẩu</h3>
                    <p class="mb-0 text-white-50 small">Nhập mật khẩu mới để khôi phục quyền truy cập vào tài khoản</p>
                </div>
                <div class="card-body p-4">
                    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                    <form asp-action="ResetPassword" method="post" class="row g-3">
                        <input type="hidden" asp-for="Email" />
                        <input type="hidden" asp-for="Token" />

                        <div class="col-12">
                            <label class="form-label fw-bold small text-muted"><i class="fa-solid fa-envelope me-1 text-primary"></i> Địa chỉ Email</label>
                            <input type="email" class="form-control" value="@Model.Email" disabled style="background-color: #f8f9fa;" />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold small text-muted"><i class="fa-solid fa-lock me-1 text-primary"></i> Mật khẩu mới</label>
                            <input asp-for="NewPassword" class="form-control" type="password" placeholder="••••••••" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small text-muted"><i class="fa-solid fa-circle-check me-1 text-primary"></i> Xác nhận mật khẩu mới</label>
                            <input asp-for="ConfirmNewPassword" class="form-control" type="password" placeholder="••••••••" required />
                        </div>

                        <div class="col-12 mt-4">
                            <button type="submit" class="btn btn-primary w-100 py-2" style="border-radius: 6px;"><i class="fa-solid fa-key me-1"></i> Lưu Mật Khẩu Mới</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
