@model HotelBooking.Application.DTOs.LoginDto

<h2>Đăng nhập</h2>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Login" method="post" asp-route-returnUrl="@ViewBag.ReturnUrl">
    <div class="mb-3">
        <label>Email</label>
        <input asp-for="Email" class="form-control" type="email" required />
    </div>
    <div class="mb-3">
        <label>Mật khẩu</label>
        <input asp-for="Password" class="form-control" type="password" required />
    </div>
    <div class="mb-3 form-check">
        <input asp-for="RememberMe" class="form-check-input" />
        <label class="form-check-label">Ghi nhớ đăng nhập</label>
    </div>
    <button type="submit" class="btn btn-primary">Đăng nhập</button>
</form>
