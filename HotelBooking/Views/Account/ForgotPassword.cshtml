@model HotelBooking.Application.DTOs.ForgotPasswordDto
@{
    ViewData["Title"] = "Quên mật khẩu";
}
<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-lg" style="border-radius: 16px; overflow: hidden;">
                <div class="p-4 text-center text-white" style="background-color: var(--primary-dark);">
                    <h3 class="mb-1 text-white" style="font-family: 'Playfair Display'; font-weight: 700;">Quên Mật Khẩu?</h3>
                    <p class="mb-0 text-white-50 small">Nhập địa chỉ email đăng ký để khôi phục mật khẩu</p>
                </div>
                <div class="card-body p-4">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success mb-4">
                            <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
                        </div>
                    }
                    <div asp-validation-summary="All" class="text-danger small mb-3"></div>
                    <form asp-action="ForgotPassword" method="post" class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-bold small text-muted"><i class="fa-solid fa-envelope me-1 text-primary"></i> Địa chỉ Email</label>
                            <input asp-for="Email" class="form-control" type="email" placeholder="example@hotel.com" required />
                        </div>
                        <div class="col-12 mt-4">
                            <button type="submit" class="btn btn-primary w-100 py-2" style="border-radius: 6px;"><i class="fa-solid fa-paper-plane me-1"></i> Gửi Yêu Cầu Khôi Phục</button>
                        </div>
                    </form>
                    <div class="text-center mt-4 border-top pt-3">
                        <a asp-action="Login" class="small fw-bold text-decoration-none text-primary"><i class="fa-solid fa-chevron-left me-1"></i> Quay lại Đăng nhập</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>