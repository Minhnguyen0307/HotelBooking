@model List<HotelBooking.Infrastructure.User>

@{
    ViewData["Title"] = "Quản lý khách hàng";
}

<div class="container my-5">
    <div class="mb-5 border-bottom pb-4">
        <h2 style="font-family: 'Playfair Display'; font-weight: 700; font-size: 2.2rem;"><i class="fa-solid fa-users-gear me-2 text-primary"></i> Quản Lý Danh Sách Khách Hàng</h2>
        <p class="text-muted mb-0">Quản trị viên có thể theo dõi danh sách thành viên và kích hoạt hoặc vô hiệu hóa tài khoản khách hàng.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="table-responsive">
        <table class="table-luxury">
            <thead>
                <tr>
                    <th>Khách Hàng</th>
                    <th>Thông Tin Liên Hệ</th>
                    <th>Ngày Tham Gia</th>
                    <th>Trạng Thái</th>
                    <th class="text-end">Hành Động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="fw-bold text-dark">
                            <span class="d-block" style="font-size: 1.1rem;">@c.FullName</span>
                            <span class="small text-muted fw-normal font-monospace">UID: #@c.UserId</span>
                        </td>
                        <td>
                            <span class="d-block"><i class="fa-solid fa-envelope me-1 text-muted"></i> @c.Email</span>
                            @if (!string.IsNullOrEmpty(c.PhoneNumber))
                            {
                                <span class="small text-muted"><i class="fa-solid fa-phone me-1 text-muted"></i> @c.PhoneNumber</span>
                            }
                            else
                            {
                                <span class="small text-muted italic">Chưa cập nhật SĐT</span>
                            }
                        </td>
                        <td>@c.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @if (c.IsActive)
                            {
                                <span class="badge-luxury bg-success text-white"><i class="fa-solid fa-circle-check me-1"></i> Đang hoạt động</span>
                            }
                            else
                            {
                                <span class="badge-luxury bg-danger text-white"><i class="fa-solid fa-user-slash me-1"></i> Bị khóa</span>
                            }
                        </td>
                        <td class="text-end">
                            <form asp-action="ToggleActive" asp-route-id="@c.UserId" method="post" class="d-inline">
                                @if (c.IsActive)
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-danger" style="border-radius: 6px;" onsubmit="return confirm('Bạn có chắc muốn tạm khóa khách hàng này không?');">
                                        <i class="fa-solid fa-lock me-1"></i> Khóa tài khoản
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-sm btn-success" style="border-radius: 6px;">
                                        <i class="fa-solid fa-lock-open me-1"></i> Mở khóa
                                    </button>
                                }
                            </form>
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-users fa-2x mb-3"></i>
                            <p class="mb-0">Hệ thống chưa có tài khoản khách hàng nào.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
