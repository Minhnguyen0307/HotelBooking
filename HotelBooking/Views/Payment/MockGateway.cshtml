@model HotelBooking.Infrastructure.Booking

@{
    ViewData["Title"] = "Cổng thanh toán mô phỏng";
    var paymentMethod = ViewBag.PaymentMethod as string;
    var room = Model.BookingRooms.FirstOrDefault()?.Room;
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-lg" style="border-radius: 16px; overflow: hidden; border: 1px solid #ddd !important;">
                <!-- Header resembling a bank/terminal gateway -->
                <div class="p-4 text-center text-white bg-dark">
                    <div class="fs-4 fw-bold font-monospace tracking-wide mb-1 text-warning"><i class="fa-solid fa-shield-halved me-2"></i> SECURE GATEWAY</div>
                    <p class="mb-0 text-white-50 small font-monospace">Transaction Ref: @Model.BookingId | Channel: @paymentMethod</p>
                </div>
                
                <div class="card-body p-4 font-monospace">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger mb-4"><i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["ErrorMessage"]</div>
                    }

                    <div class="p-3 mb-4 rounded border" style="background-color: #f8f9fa;">
                        <span class="small text-muted d-block uppercase">Đơn vị thụ hưởng:</span>
                        <h5 class="fw-bold mb-3 text-dark">Luxury Hotel Booking System</h5>
                        
                        <div class="d-flex justify-content-between border-top pt-2">
                            <span class="small text-muted">Số tiền cần thanh toán:</span>
                            <span class="fw-bold text-danger">@Model.TotalPrice.ToString("N0") đ</span>
                        </div>
                    </div>

                    <form asp-action="ProcessPayment" method="post">
                        <input type="hidden" name="bookingId" value="@Model.BookingId" />
                        <input type="hidden" name="paymentMethod" value="@paymentMethod" />

                        @if (paymentMethod == "CreditCard")
                        {
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted">SỐ THẺ (CARD NUMBER)</label>
                                <input name="cardNumber" type="text" class="form-control font-monospace" placeholder="4111 2222 3333 4444" required />
                            </div>
                            <div class="row mb-3">
                                <div class="col-6">
                                    <label class="form-label small fw-bold text-muted">NGÀY HẾT HẠN (MM/YY)</label>
                                    <input type="text" class="form-control font-monospace" placeholder="12/29" required />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-bold text-muted">MÃ CVV</label>
                                    <input type="password" class="form-control font-monospace" placeholder="•••" maxlength="3" required />
                                </div>
                            </div>
                            <div class="mb-4">
                                <label class="form-label small fw-bold text-muted">TÊN TRÊN THẺ (CARDHOLDER NAME)</label>
                                <input type="text" class="form-control font-monospace" placeholder="NGUYEN VAN A" style="text-transform: uppercase;" required />
                            </div>
                        }
                        else
                        {
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted">SỐ ĐIỆN THOẠI ĐĂNG KÝ VÍ (PHONE NUMBER)</label>
                                <input name="cardNumber" type="tel" class="form-control font-monospace" placeholder="0901234567" required />
                            </div>
                            <div class="mb-4">
                                <label class="form-label small fw-bold text-muted">MÃ PIN XÁC THỰC (PIN CODE)</label>
                                <input type="password" class="form-control font-monospace" placeholder="••••••" maxlength="6" required />
                            </div>
                        }

                        <div class="alert alert-info py-2 small mb-4">
                            <i class="fa-solid fa-circle-info me-2 text-info"></i> Đây là môi trường thanh toán mô phỏng. Bất kỳ thông tin nhập vào nào cũng sẽ được xử lý thành công.
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-dark btn-lg py-3 fw-bold font-monospace"><i class="fa-solid fa-circle-check me-2 text-warning"></i> XÁC NHẬN THANH TOÁN (PAY NOW)</button>
                            <a asp-action="Pay" asp-route-bookingId="@Model.BookingId" class="btn btn-outline-secondary font-monospace">QUAY LẠI</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
