@{
    var revenue = (List<HotelBooking.Application.DTOs.MonthlyRevenueDto>)ViewBag.Revenue;
    var occupancy = (List<HotelBooking.Application.DTOs.RoomOccupancyDto>)ViewBag.Occupancy;
    ViewData["Title"] = "Báo cáo thống kê";
}

<div class="container my-5 no-print">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-5 border-bottom pb-4">
        <div>
            <h2 style="font-family: 'Playfair Display'; font-weight: 700; font-size: 2.2rem;"><i class="fa-solid fa-chart-line me-2 text-primary"></i> Báo Cáo Thống Kê & Doanh Thu</h2>
            <p class="text-muted mb-0">Xem số liệu thống kê doanh số bán phòng và hiệu suất sử dụng phòng của khách sạn.</p>
        </div>
        <div class="mt-3 mt-md-0">
            <button onclick="window.print()" class="btn btn-outline-primary" style="border-radius: 6px;"><i class="fa-solid fa-print me-1"></i> In Báo Cáo (PDF)</button>
        </div>
    </div>

    <div class="row g-5">
        <!-- Revenue Report -->
        <div class="col-lg-6">
            <div class="p-4 bg-white rounded-4 shadow-sm border" style="border-radius: 16px;">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="mb-0 text-dark" style="font-family: 'Playfair Display'; font-weight: 700;"><i class="fa-solid fa-coins text-warning me-2"></i> Doanh Thu Theo Tháng</h4>
                    <a asp-action="ExportRevenueCsv" class="btn btn-sm btn-outline-success" style="border-radius: 6px;"><i class="fa-solid fa-file-excel me-1"></i> Xuất CSV</a>
                </div>
                
                <div class="table-responsive">
                    <table class="table-luxury">
                        <thead>
                            <tr>
                                <th>Thời Gian</th>
                                <th>Số Lượng Đơn</th>
                                <th class="text-end">Doanh Thu</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in revenue)
                            {
                                <tr>
                                    <td class="fw-bold">Tháng @r.Month / @r.Year</td>
                                    <td>@r.TotalBookingsPaid đơn hàng</td>
                                    <td class="text-end fw-bold text-success" style="font-size: 1.1rem;">@r.TotalRevenue.ToString("N0") đ</td>
                                </tr>
                            }

                            @if (!revenue.Any())
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-4 text-muted small">Chưa có số liệu doanh thu phát sinh.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Occupancy Report -->
        <div class="col-lg-6">
            <div class="p-4 bg-white rounded-4 shadow-sm border" style="border-radius: 16px;">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="mb-0 text-dark" style="font-family: 'Playfair Display'; font-weight: 700;"><i class="fa-solid fa-percent text-info me-2"></i> Hiệu Suất Sử Dụng Phòng</h4>
                    <a asp-action="ExportOccupancyCsv" class="btn btn-sm btn-outline-success" style="border-radius: 6px;"><i class="fa-solid fa-file-excel me-1"></i> Xuất CSV</a>
                </div>
                
                <div class="table-responsive">
                    <table class="table-luxury">
                        <thead>
                            <tr>
                                <th>Số Phòng</th>
                                <th>Lượt Đặt Phòng</th>
                                <th class="text-end">Tổng Số Đêm</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in occupancy)
                            {
                                <tr>
                                    <td class="fw-bold text-dark">Room @o.RoomNumber</td>
                                    <td>@o.TotalBookings lượt</td>
                                    <td class="text-end fw-bold">@o.TotalNightsBooked đêm</td>
                                </tr>
                            }

                            @if (!occupancy.Any())
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-4 text-muted small">Chưa có số liệu lượt đặt phòng trống.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Print-Only Layout -->
<div class="print-only d-none">
    <div class="text-center mb-5">
        <h1 style="font-family: 'Playfair Display'; font-weight: bold;">BÁO CÁO HOẠT ĐỘNG KHÁCH SẠN</h1>
        <p class="text-muted">Ngày xuất báo cáo: @DateTime.Today.ToString("dd/MM/yyyy")</p>
    </div>

    <div class="mb-5">
        <h3>1. Báo cáo doanh thu theo tháng</h3>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Thời Gian</th>
                    <th>Số Lượng Đơn Đã Thanh Toán</th>
                    <th>Tổng Doanh Thu (VNĐ)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in revenue)
                {
                    <tr>
                        <td>Tháng @r.Month / @r.Year</td>
                        <td>@r.TotalBookingsPaid đơn</td>
                        <td class="fw-bold">@r.TotalRevenue.ToString("N0") đ</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div>
        <h3>2. Tần suất và hiệu suất sử dụng phòng</h3>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Số Phòng</th>
                    <th>Tổng Lượt Đặt Phòng</th>
                    <th>Tổng Số Đêm Cho Thuê</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in occupancy)
                {
                    <tr>
                        <td>Room @o.RoomNumber</td>
                        <td>@o.TotalBookings lượt</td>
                        <td>@o.TotalNightsBooked đêm</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    @@media print {
        .no-print, header, footer, nav, .btn {
            display: none !important;
        }
        .print-only {
            display: block !important;
        }
        body {
            background-color: white !important;
            color: black !important;
            padding: 0 !important;
            margin: 0 !important;
        }
        .container {
            margin-top: 0 !important;
            max-width: 100% !important;
            width: 100% !important;
        }
    }
</style>