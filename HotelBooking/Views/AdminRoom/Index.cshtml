@model List<HotelBooking.Application.DTOs.RoomManageListItemDto>

@{
    ViewData["Title"] = "Quản lý phòng";
}

<div class="container my-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-5 border-bottom pb-4">
        <div>
            <h2 style="font-family: 'Playfair Display'; font-weight: 700; font-size: 2.2rem;"><i class="fa-solid fa-gears me-2 text-primary"></i> Quản Lý Danh Sách Phòng</h2>
            <p class="text-muted mb-0">Quản trị viên có quyền cập nhật trạng thái phòng, thêm mới và chỉnh sửa thông tin phòng.</p>
        </div>
        <div class="mt-3 mt-md-0">
            <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus me-1"></i> Thêm Phòng Mới</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="table-responsive">
        <table class="table-luxury">
            <thead>
                <tr>
                    <th>Số Phòng</th>
                    <th>Loại Phòng</th>
                    <th>Tầng</th>
                    <th>Trạng Thái Hoạt Động</th>
                    <th class="text-end">Hành Động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td class="fw-bold text-dark" style="font-size: 1.1rem;">Room @r.RoomNumber</td>
                        <td>@r.TypeName</td>
                        <td>Tầng @r.Floor</td>
                        <td>
                            <form asp-action="UpdateStatus" method="post" class="d-flex align-items-center gap-2">
                                <input type="hidden" name="roomId" value="@r.RoomId" />
                                <select name="status" class="form-select form-select-sm fw-bold border-secondary" style="width: auto; border-radius: 6px;" onchange="this.form.submit()">
                                    <option value="Available" selected='@(r.Status == "Available")'>Trống (Available)</option>
                                    <option value="Booked" selected='@(r.Status == "Booked")'>Đã đặt (Booked)</option>
                                    <option value="Maintenance" selected='@(r.Status == "Maintenance")'>Bảo trì (Maintenance)</option>
                                </select>
                            </form>
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@r.RoomId" class="btn btn-sm btn-outline-primary" style="border-radius: 6px;"><i class="fa-solid fa-pen-to-square me-1"></i> Sửa</a>
                            <form asp-action="Delete" asp-route-id="@r.RoomId" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa phòng @r.RoomNumber không?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger" style="border-radius: 6px;"><i class="fa-solid fa-trash-can me-1"></i> Xóa</button>
                            </form>
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-bed fa-2x mb-3"></i>
                            <p class="mb-0">Chưa có phòng nào được đăng ký trong hệ thống.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>