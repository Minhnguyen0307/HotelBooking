@model List<HotelBooking.Infrastructure.RoomType>

@{
    ViewData["Title"] = "Quản lý loại phòng";
}

<div class="container my-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-5 border-bottom pb-4">
        <div>
            <h2 style="font-family: 'Playfair Display'; font-weight: 700; font-size: 2.2rem;"><i class="fa-solid fa-layer-group me-2 text-primary"></i> Quản Lý Loại Phòng</h2>
            <p class="text-muted mb-0">Quản trị viên có thể thiết lập các loại phòng, mức giá tiêu chuẩn và số khách tối đa.</p>
        </div>
        <div class="mt-3 mt-md-0">
            <a asp-action="Create" class="btn btn-primary" style="border-radius: 6px;"><i class="fa-solid fa-plus me-1"></i> Thêm Loại Phòng Mới</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="table-responsive">
        <table class="table-luxury">
            <thead>
                <tr>
                    <th>Tên Loại Phòng</th>
                    <th>Giá Cơ Bản (Một Đêm)</th>
                    <th>Số Khách Tối Đa</th>
                    <th>Trạng Thái</th>
                    <th class="text-end">Hành Động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rt in Model)
                {
                    <tr>
                        <td class="fw-bold text-dark">
                            <span class="d-block" style="font-size: 1.1rem;">@rt.TypeName</span>
                            <span class="small text-muted fw-normal font-sans text-truncate d-inline-block" style="max-width: 350px;">@rt.Description</span>
                        </td>
                        <td class="fw-bold text-danger">@rt.BasePrice.ToString("N0") đ</td>
                        <td><i class="fa-solid fa-user-group me-1 text-muted"></i> @rt.MaxGuests khách</td>
                        <td>
                            @if (rt.IsActive)
                            {
                                <span class="badge-luxury bg-success text-white"><i class="fa-solid fa-circle-check me-1"></i> Hoạt động</span>
                            }
                            else
                            {
                                <span class="badge-luxury bg-secondary text-white"><i class="fa-solid fa-ban me-1"></i> Tạm ngưng</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@rt.RoomTypeId" class="btn btn-sm btn-outline-primary" style="border-radius: 6px;"><i class="fa-solid fa-pen-to-square me-1"></i> Sửa</a>
                            <form asp-action="Delete" asp-route-id="@rt.RoomTypeId" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa loại phòng này?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger" style="border-radius: 6px;"><i class="fa-solid fa-trash-can me-1"></i> Xóa</button>
                            </form>
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-layer-group fa-2x mb-3"></i>
                            <p class="mb-0">Chưa có loại phòng nào được đăng ký.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
