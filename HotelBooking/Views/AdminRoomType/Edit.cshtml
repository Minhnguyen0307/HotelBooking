@model HotelBooking.Infrastructure.RoomType

@{
    ViewData["Title"] = "Chỉnh sửa loại phòng";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg" style="border-radius: 16px; overflow: hidden;">
                <div class="p-4 text-center text-white" style="background-color: var(--primary-dark);">
                    <h3 class="mb-1 text-white" style="font-family: 'Playfair Display'; font-weight: 700;">Chỉnh Sửa Loại Phòng</h3>
                    <p class="mb-0 text-white-50 small">Cập nhật thông tin chi tiết cho loại phòng</p>
                </div>
                <div class="card-body p-4">
                    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                    <form asp-action="Edit" method="post" class="row g-3">
                        <input type="hidden" asp-for="RoomTypeId" />

                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted"><i class="fa-solid fa-tag me-1 text-primary"></i> Tên loại phòng</label>
                            <input asp-for="TypeName" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted"><i class="fa-solid fa-dollar-sign me-1 text-primary"></i> Giá cơ bản (VNĐ / Đêm)</label>
                            <input asp-for="BasePrice" class="form-control" type="number" step="1000" min="0" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted"><i class="fa-solid fa-user-group me-1 text-primary"></i> Số khách tối đa</label>
                            <input asp-for="MaxGuests" class="form-control" type="number" min="1" required />
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check mb-2">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                <label class="form-check-label fw-bold small text-muted">Kích hoạt trạng thái hoạt động</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small text-muted"><i class="fa-solid fa-align-left me-1 text-primary"></i> Mô tả ngắn</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="col-12 mt-4 border-top pt-4 d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-outline-secondary" style="border-radius: 6px;">Hủy bỏ</a>
                            <button type="submit" class="btn btn-primary px-4 py-2" style="border-radius: 6px;"><i class="fa-solid fa-floppy-disk me-1"></i> Lưu Thay Đổi</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
