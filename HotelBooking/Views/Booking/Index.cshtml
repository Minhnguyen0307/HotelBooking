@model List<HotelBooking.Application.DTOs.BookingListItemDto>

@{
    ViewData["Title"] = "Lịch sử đặt phòng";
}

<div class="container my-5">
    <div class="mb-5">
        <h2 style="font-family: 'Playfair Display'; font-weight: 700; font-size: 2.2rem;"><i class="fa-solid fa-clock-rotate-left me-2 text-primary"></i> Đơn Đặt Phòng Của Tôi</h2>
        <p class="text-muted">Xem và quản lý tất cả lịch sử đặt phòng của bạn tại khách sạn.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="table-responsive">
        <table class="table-luxury">
            <thead>
                <tr>
                    <th>Mã Đơn</th>
                    <th>Chi Tiết Phòng</th>
                    <th>Ngày Nhận</th>
                    <th>Ngày Trả</th>
                    <th>Trạng Thái</th>
                    <th>Tổng Chi Phí</th>
                    <th class="text-end">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td class="fw-bold">#@b.BookingId</td>
                        <td>
                            <span class="d-block fw-bold text-dark">Phòng @b.RoomNumber</span>
                            <span class="small text-muted">@b.TypeName</span>
                        </td>
                        <td>@b.CheckInDate.ToString("dd/MM/yyyy")</td>
                        <td>@b.CheckOutDate.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (b.Status == "Pending")
                            {
                                <span class="badge-luxury bg-warning text-dark"><i class="fa-solid fa-hourglass-start me-1"></i> Chờ duyệt</span>
                            }
                            else if (b.Status == "Confirmed")
                            {
                                <span class="badge-luxury bg-success text-white"><i class="fa-solid fa-circle-check me-1"></i> Đã xác nhận</span>
                            }
                            else if (b.Status == "CheckedIn")
                            {
                                <span class="badge-luxury bg-primary text-white"><i class="fa-solid fa-key me-1"></i> Đang ở</span>
                            }
                            else if (b.Status == "CheckedOut")
                            {
                                <span class="badge-luxury bg-secondary text-white"><i class="fa-solid fa-door-closed me-1"></i> Đã trả phòng</span>
                            }
                            else if (b.Status == "Cancelled")
                            {
                                <span class="badge-luxury bg-danger text-white"><i class="fa-solid fa-ban me-1"></i> Đã hủy</span>
                            }
                            else
                            {
                                <span class="badge bg-info text-white">@b.Status</span>
                            }
                        </td>
                        <td class="fw-bold text-dark">@b.TotalPrice.ToString("N0") đ</td>
                        <td class="text-end">
                            @if (b.Status == "Pending")
                            {
                                <a asp-controller="Payment" asp-action="Pay" asp-route-bookingId="@b.BookingId" class="btn btn-sm btn-success me-1" style="border-radius: 6px;"><i class="fa-solid fa-credit-card me-1"></i> Thanh Toán</a>
                            }
                            @if (b.Status == "Pending" || b.Status == "Confirmed")
                            {
                                <form asp-action="Cancel" method="post" onsubmit="return confirm('Bạn chắc chắn muốn hủy đơn đặt phòng này?');" class="d-inline">
                                    <input type="hidden" name="bookingId" value="@b.BookingId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" style="border-radius: 6px;"><i class="fa-solid fa-xmark me-1"></i> Hủy Đơn</button>
                                </form>
                            }
                            else
                            {
                                <span class="small text-muted">-</span>
                            }
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-receipt fa-2x mb-3 text-muted opacity-50"></i>
                            <p class="mb-0">Bạn chưa thực hiện bất kỳ giao dịch đặt phòng nào.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
